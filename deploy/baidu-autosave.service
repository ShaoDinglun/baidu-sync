[Unit]
Description=Baidu Autosave Web and Scheduler Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=leon
Group=leon
WorkingDirectory=/home/leon/baidu-autosave
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Shanghai
Environment=WEB_APP_HOST=0.0.0.0
Environment=WEB_APP_PORT=3001
ExecStart=/home/leon/baidu-autosave/.venv/bin/python -m backend.web_app
ExecStartPost=-/home/leon/baidu-autosave/.venv/bin/python /home/leon/baidu-autosave/scripts/service_lifecycle_notify.py start
ExecStopPost=-/home/leon/baidu-autosave/.venv/bin/python /home/leon/baidu-autosave/scripts/service_lifecycle_notify.py failure ${SERVICE_RESULT} ${EXIT_CODE} ${EXIT_STATUS}
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
